# ============================================================
# WeatherGPT - environment variables
# Copy this file to .env and fill in the values.
# ============================================================

# --- Third-party API keys (required) ---

# Google AI Studio key, used for both the /chat endpoint (Gemini) and
# for generating embeddings for the semantic chat cache.
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenWeather key, used for geocoding + current/forecast weather.
# Get one free at: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Database (Postgres + PostGIS + pgvector) ---
# These three are read by the "db" service in docker-compose.yml to
# initialize the Postgres container itself.
POSTGRES_USER=weathergpt
POSTGRES_PASSWORD=weathergpt_password
POSTGRES_DB=weathergpt

# Read by the backend (database.py) to connect. The host "db" is the
# docker-compose service name above, NOT localhost - containers reach
# each other by service name on the compose network. Keep the
# user/password/db name in sync with the three POSTGRES_* values
# above.
DATABASE_URL=postgresql://weathergpt:weathergpt_password@db:5432/weathergpt

# --- Optional tuning ---

# Gemini embedding model used for the semantic chat cache.
# EMBEDDING_MODEL=text-embedding-004

# Cosine-distance cutoff for the chat cache: 0 = identical meaning,
# 2 = opposite. Lower = stricter (fewer, safer cache hits).
# CHAT_CACHE_SIMILARITY_THRESHOLD=0.08
